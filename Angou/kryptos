import argparse
import sys
import pykakasi

def kana_to_romaji(text):
    kks = pykakasi.kakasi()
    result = kks.convert(text)
    return ''.join(item['hepburn'] for item in result)

def caesar_cipher(text, shift):
    result = []
    for char in text:
        if 'A' <= char <= 'Z':
            result.append(chr((ord(char) - ord('A') + shift) % 26 + ord('A')))
        elif 'a' <= char <= 'z':
            result.append(chr((ord(char) - ord('a') + shift) % 26 + ord('a')))
        else:
            result.append(char)
    return ''.join(result)

def main():
    parser = argparse.ArgumentParser(description='日本語と英数字の混じったテキストをローマ字のテキスト変換し、シーザー暗号でさらに変換することができるコマンドです。')
    parser.add_argument('file', nargs='?', help='入力ファイル（省略時は標準入力）')
    parser.add_argument('-s', '--shift', type=int, default=3, help='ずらす文字数（初期値: 3）')
    parser.add_argument('-d', '--decrypt', action='store_true', help='復号（元に戻す）モード')
    args = parser.parse_args()

    shift = -args.shift if args.decrypt else args.shift

    if args.file:
        with open(args.file, 'r', encoding='utf-8') as f:
            content = f.read()
    else:
        content = sys.stdin.read()

    for line in content.splitlines(keepends=True):
        stripped = line.rstrip('\r\n')
        newline = line[len(stripped):]

        if not args.decrypt:
            stripped = kana_to_romaji(stripped)

        sys.stdout.write(caesar_cipher(stripped, shift) + newline)


if __name__ == '__main__':
    main()
